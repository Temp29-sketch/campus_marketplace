# Copy to .env for local use (never commit .env). On a host, set these as environment variables.

# --- Required in production (APP_ENV=production) -------------------------------------
APP_ENV=development                    # set to "production" when live
SECRET_KEY=                            # python -c "import secrets; print(secrets.token_hex(32))"
PUBLIC_BASE_URL=                       # https://yourdomain.com   (used in emailed links)
DATABASE_URL=                          # postgresql://user:pass@host:5432/dbname

# --- Email (production needs SMTP) ---------------------------------------------------
MAIL_BACKEND=console                   # "console" prints emails (dev); production uses "smtp"
MAIL_FROM=                             # UniHub <no-reply@yourdomain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true                      # STARTTLS on 587. For port 465 set SMTP_USE_SSL=true and SMTP_USE_TLS=false

# --- Photos ----------------------------------------------------------------------------
STORAGE_BACKEND=local                  # "local" or "s3" (Cloudflare R2, AWS S3, Backblaze B2...)
UPLOAD_FOLDER=                         # local only; defaults to ./uploads
S3_BUCKET=
S3_ENDPOINT_URL=                       # R2: https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=                    # public address photos load from, e.g. https://photos.yourdomain.com

# --- Optional ------------------------------------------------------------------------------
BEHIND_PROXY=true                      # production default; trust ONE proxy for client IP / https
RATELIMIT_STORAGE_URI=memory://        # use redis://... when running more than one worker
WEB_CONCURRENCY=2                      # gunicorn workers
ALLOW_SQLITE=                          # set to 1 only if you run one server with a persistent disk
